{
  "name": "boomboom-doodle-royale",
  "version": "1.0.0",
  "private": true,
  "description": "A LAN-first 3D multiplayer browser game where players battle, escape, and draw solid magic ink.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daksh-mor/boomboom.git"
  },
  "bugs": {
    "url": "https://github.com/daksh-mor/boomboom/issues"
  },
  "homepage": "https://github.com/daksh-mor/boomboom#readme",
  "keywords": [
    "threejs",
    "socket.io",
    "typescript",
    "multiplayer",
    "browser-game",
    "fps",
    "drawing-game",
    "party-game",
    "lan-game",
    "open-source-game"
  ],
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "e2e:socket": "node e2e/socket.test.mjs",
    "e2e:browser": "node e2e/browser.test.mjs",
    "test:controller": "tsx client/test/playerController.test.ts",
    "test:ink": "tsx client/test/ink.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1"
  }
}
